# ==============================================================================
# MEDREASON — CLINICAL MULTIMODAL RAG ASSISTANT
# ==============================================================================

# Text LLM: mock | gemini | openai | groq | ollama
LLM_PROVIDER=mock
LLM_MODEL=qwen/qwen3.8-27b
LLM_API_KEY=

# Vision / VLM: mock | gemini | openai
# Falls back to LLM_API_KEY only when VISION_API_KEY is blank.
VISION_PROVIDER=gemini
VISION_MODEL=gemini-flash-lite-latest
VISION_API_KEY=

# Speech: local | whisper | mock
# For whisper, install: pip install faster-whisper
SPEECH_PROVIDER=local
WHISPER_MODEL=base

# Embeddings: hashing_cosine | local_transformers
EMBEDDING_PROVIDER=hashing_cosine
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Limits
MAX_UPLOAD_SIZE_BYTES=52428800
MAX_VIDEO_DURATION_SECONDS=180
VIDEO_FRAME_INTERVAL_SECONDS=2

# CORS (not required on Vercel because the UI and API share one origin)
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000"]

# ------------------------------------------------------------------------------
# Serverless / Vercel deployment
# ------------------------------------------------------------------------------
# SQLite files are not durable on serverless. Supply a hosted Postgres URL
# (e.g. Neon free tier): postgresql+pg8000://user:pass@host/db?sslmode=require
DATABASE_URL=
# local     = write uploads to disk (development)
# database  = store upload bytes in Postgres and stage them in TEMP_DIR per request
STORAGE_BACKEND=local
TEMP_DIR=/tmp/medreason

# Vercel Hobby functions time out after ~10s. Use the offline providers there;
# switch to groq/gemini only on Pro with a larger maxDuration.
# LLM_PROVIDER=mock
# VISION_PROVIDER=mock

# Frontend (place in frontend/.env)
# VITE_API_URL=http://127.0.0.1:8000/api
